# =============================================================
# QualityPilot AI — Environment Configuration
# Copy this to .env and fill in your values
# =============================================================

# --- APPLICATION & RUNTIME ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
PORT=4000

# --- DATABASE (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qualitypilot?schema=public"

# --- CACHE & QUEUE (Redis) ---
REDIS_URL="redis://localhost:6379"

# --- AUTHENTICATION & SECURITY ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN="7d"

# --- AI PROVIDERS CONFIGURATION ---
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai
AI_TEMPERATURE=0.2

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL="gpt-4o"

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# --- EMAIL SERVICE CONFIGURATION (Gmail SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SECURE=true
SMTP_FROM='"QualityPilot AI" <your@gmail.com>'

# Resend (Optional fallback)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="QualityPilot AI <onboarding@resend.dev>"

# --- GITHUB OAUTH ---
# From: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# --- OBJECT STORAGE (Optional) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="qualitypilot-artifacts"
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_FORCE_PATH_STYLE=true

# --- BROWSER AUTOMATION ---
PLAYWRIGHT_BROWSERS="chromium,firefox,webkit"
TEST_DEFAULT_TIMEOUT=30000
TEST_MAX_RETRIES=2
TEST_MAX_WORKERS=4

# --- THIRD-PARTY INTEGRATIONS (Optional) ---
SENTRY_DSN=""
SLACK_WEBHOOK_URL=""
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
